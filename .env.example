# Copie para .env.local e preencha. Nunca commite o .env.local.

# Banco (Supabase > Connect > ORMs > Prisma)
# Pooler, porta 6543, com ?pgbouncer=true: usado pela aplicação
DATABASE_URL=
# Conexão direta/sessão, porta 5432: usada pelas migrations do Prisma
DIRECT_URL=

# Supabase Auth (Project Settings > API). Só o endereço base, sem /rest/v1/:
# https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave "publishable" (sb_publishable_...) ou a antiga "anon"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Melhor Envio (frete e etiquetas). Token com as permissões shipping-calculate,
# cart-read, cart-write, shipping-checkout, shipping-generate, shipping-print,
# shipping-tracking, shipping-cancel, orders-read e users-read.
# Testes: conta em sandbox.melhorenvio.com.br e AMBIENTE=sandbox.
MELHOR_ENVIO_TOKEN=
# sandbox ou producao
MELHOR_ENVIO_AMBIENTE=
# CEP de onde os pedidos saem (8 números)
MELHOR_ENVIO_CEP_ORIGEM=
# E-mail de contato técnico, exigido pelo Melhor Envio em cada chamada
MELHOR_ENVIO_EMAIL_CONTATO=

# Remetente das etiquetas (dados da loja impressos no pacote). Cidade e UF vêm
# do MELHOR_ENVIO_CEP_ORIGEM. Documento: CPF (11 números) ou CNPJ (14).
MELHOR_ENVIO_REMETENTE_NOME=
MELHOR_ENVIO_REMETENTE_TELEFONE=
MELHOR_ENVIO_REMETENTE_DOCUMENTO=
MELHOR_ENVIO_REMETENTE_ENDERECO=
MELHOR_ENVIO_REMETENTE_NUMERO=
MELHOR_ENVIO_REMETENTE_BAIRRO=
# Opcionais
MELHOR_ENVIO_REMETENTE_COMPLEMENTO=
# Inscrição estadual, só com CNPJ
MELHOR_ENVIO_REMETENTE_IE=
# Se vazio, usa MELHOR_ENVIO_EMAIL_CONTATO
MELHOR_ENVIO_REMETENTE_EMAIL=

# Mercado Pago (Checkout Pro). Testes: Access Token da conta vendedora de teste
# da aplicação (botão "Ativar credenciais" no painel de desenvolvedores).
MERCADO_PAGO_ACCESS_TOKEN=
# Webhooks > Configurar notificações > Assinatura secreta
MERCADO_PAGO_WEBHOOK_SECRET=

# Tarefa diária (Vercel Cron, vercel.json): segredo que a Vercel manda no
# cabeçalho Authorization. Texto aleatório com 16 caracteres ou mais, por
# exemplo gerado com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# E-mails (Resend, resend.com). API Key com permissão "Sending access".
RESEND_API_KEY=
# Remetente. Sem domínio verificado no Resend, deixe vazio: usa
# "Carta Viva <onboarding@resend.dev>", que só entrega para o
# e-mail da conta do Resend. Com o domínio: Carta Viva <pedidos@lojacartaviva.com.br>
EMAIL_REMETENTE=
# Recebe os avisos da loja (pedido pago, alertas, personalização, orçamento)
EMAIL_DA_LOJA=
# Para onde vão as respostas dos clientes (vazio = EMAIL_DA_LOJA)
EMAIL_RESPONDER_PARA=
# MODO DE TESTE: se preenchido, TODOS os e-mails vão para este endereço, com o
# destinatário real no assunto. Deixe vazio em produção.
EMAIL_DESTINO_TESTE=
# Endereço do site nos links dos e-mails (ex.: https://cartaviva.com.br).
# Vazio = endereço da requisição atual.
SITE_URL=
