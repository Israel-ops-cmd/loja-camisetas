# Copie para .env.local e preencha. Nunca commite o .env.local.

# Banco (Supabase > Connect > ORMs > Prisma)
# Pooler, porta 6543, com ?pgbouncer=true: usado pela aplicação
DATABASE_URL=
# Conexão direta/sessão, porta 5432: usada pelas migrations do Prisma
DIRECT_URL=

# Supabase Auth (Project Settings > API). Só o endereço base, sem /rest/v1/:
# https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave "publishable" (sb_publishable_...) ou a antiga "anon"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Melhor Envio (frete). Token com a permissão "shipping-calculate".
# Testes: conta em sandbox.melhorenvio.com.br e AMBIENTE=sandbox.
MELHOR_ENVIO_TOKEN=
# sandbox ou producao
MELHOR_ENVIO_AMBIENTE=
# CEP de onde as camisetas saem (8 números)
MELHOR_ENVIO_CEP_ORIGEM=
# E-mail de contato técnico, exigido pelo Melhor Envio em cada chamada
MELHOR_ENVIO_EMAIL_CONTATO=

# Mercado Pago (Checkout Pro). Testes: Access Token da conta vendedora de teste
# da aplicação (botão "Ativar credenciais" no painel de desenvolvedores).
MERCADO_PAGO_ACCESS_TOKEN=
# Webhooks > Configurar notificações > Assinatura secreta
MERCADO_PAGO_WEBHOOK_SECRET=

# Tarefa diária (Vercel Cron, vercel.json): segredo que a Vercel manda no
# cabeçalho Authorization. Texto aleatório com 16 caracteres ou mais, por
# exemplo gerado com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
