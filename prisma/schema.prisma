// Schema do banco da Carta Viva Camisetas.
// Preços sempre em centavos (Int). Estoque controlado por variação (produto + cor + tamanho).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Catálogo

model Categoria {
  id       String    @id @default(uuid(7)) @db.Uuid
  nome     String
  slug     String    @unique
  ordem    Int       @default(0)
  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id                  String           @id @default(uuid(7)) @db.Uuid
  nome                String
  slug                String           @unique
  descricao           String?
  precoBaseEmCentavos Int
  ativo               Boolean          @default(true)
  destaque            Boolean          @default(false)
  // Pacote de uma unidade, para o cálculo de frete. Padrão PROVISÓRIO
  // (camiseta embalada estimada): confirmar com a medida real.
  pesoEmGramas        Int              @default(300)
  larguraCm           Int              @default(22)
  alturaCm            Int              @default(4)
  comprimentoCm       Int              @default(28)
  categoriaId         String           @db.Uuid
  categoria           Categoria        @relation(fields: [categoriaId], references: [id])
  variacoes           Variacao[]
  imagens             ProdutoImagem[]
  personalizacoes     Personalizacao[]
  criadoEm            DateTime         @default(now())
  atualizadoEm        DateTime         @updatedAt

  @@index([categoriaId])
  @@map("produtos")
}

model Cor {
  id              String           @id @default(uuid(7)) @db.Uuid
  nome            String           @unique
  /// Hexadecimal, ex.: #141414
  hex             String
  variacoes       Variacao[]
  imagens         ProdutoImagem[]
  personalizacoes Personalizacao[]

  @@map("cores")
}

model Tamanho {
  id                    String               @id @default(uuid(7)) @db.Uuid
  nome                  String               @unique
  /// Ordem de exibição (P antes de M...)
  ordem                 Int
  variacoes             Variacao[]
  itensDePersonalizacao PersonalizacaoItem[]

  @@map("tamanhos")
}

/// Uma combinação vendável de produto + cor + tamanho, com o seu estoque.
model Variacao {
  id              String                @id @default(uuid(7)) @db.Uuid
  sku             String                @unique
  estoque         Int                   @default(0)
  /// Quando nulo, vale o preço base do produto.
  precoEmCentavos Int?
  ativo           Boolean               @default(true)
  produtoId       String                @db.Uuid
  produto         Produto               @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  corId           String                @db.Uuid
  cor             Cor                   @relation(fields: [corId], references: [id])
  tamanhoId       String                @db.Uuid
  tamanho         Tamanho               @relation(fields: [tamanhoId], references: [id])
  movimentacoes   MovimentacaoEstoque[]
  itensPedido     ItemPedido[]

  @@unique([produtoId, corId, tamanhoId])
  @@map("variacoes")
}

model ProdutoImagem {
  id            String  @id @default(uuid(7)) @db.Uuid
  url           String
  alt           String
  ordem         Int     @default(0)
  /// Valor de `object-position` para enquadrar a estampa no recorte (ex.: "50% 45%").
  /// Nulo: centralizado.
  enquadramento String?
  produtoId     String  @db.Uuid
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  /// Quando preenchida, a foto aparece ao escolher essa cor.
  corId         String? @db.Uuid
  cor           Cor?    @relation(fields: [corId], references: [id])

  @@index([produtoId])
  @@map("produto_imagens")
}

enum MotivoMovimentacao {
  ENTRADA
  VENDA
  AJUSTE
  CANCELAMENTO

  @@map("motivo_movimentacao")
}

/// Histórico do estoque. A baixa por venda guarda o pedido, e a combinação
/// (pedido, variação, motivo) é única: um webhook repetido não desconta duas vezes.
model MovimentacaoEstoque {
  id         String             @id @default(uuid(7)) @db.Uuid
  /// Positiva para entrada, negativa para saída.
  quantidade Int
  motivo     MotivoMovimentacao
  observacao String?
  variacaoId String             @db.Uuid
  variacao   Variacao           @relation(fields: [variacaoId], references: [id])
  pedidoId   String?            @db.Uuid
  pedido     Pedido?            @relation(fields: [pedidoId], references: [id])
  criadoEm   DateTime           @default(now())

  @@unique([pedidoId, variacaoId, motivo])
  @@index([variacaoId])
  @@map("movimentacoes_estoque")
}

// ---------------------------------------------------------------- Clientes

model Cliente {
  /// Mesmo id do usuário no Supabase Auth (auth.users.id).
  id              String           @id @db.Uuid
  nome            String
  email           String           @unique
  telefone        String?
  /// Opcional no cadastro; exigido no checkout (boleto e etiqueta de envio).
  cpf             String?
  enderecos       Endereco[]
  pedidos         Pedido[]
  personalizacoes Personalizacao[]
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt

  @@map("clientes")
}

model Endereco {
  id           String   @id @default(uuid(7)) @db.Uuid
  destinatario String
  cep          String
  logradouro   String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  uf           String   @db.Char(2)
  principal    Boolean  @default(false)
  clienteId    String   @db.Uuid
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())

  @@index([clienteId])
  @@map("enderecos")
}

// ---------------------------------------------------------------- Pedidos

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO

  @@map("status_pedido")
}

model Pedido {
  id     String       @id @default(uuid(7)) @db.Uuid
  /// Número mostrado ao cliente (#1001, #1002...).
  numero Int          @unique @default(autoincrement())
  status StatusPedido @default(AGUARDANDO_PAGAMENTO)

  clienteId String  @db.Uuid
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  /// Gerada ao abrir o checkout. Um segundo envio com a mesma chave
  /// (clique duplo, internet oscilando) devolve o pedido já criado.
  chaveIdempotencia String? @unique @db.Uuid

  // Cópia dos dados do comprador no momento da compra.
  compradorNome     String
  compradorEmail    String
  /// Só os 11 dígitos.
  compradorCpf      String
  /// Só os dígitos, com DDD.
  compradorTelefone String

  subtotalEmCentavos Int
  freteEmCentavos    Int
  descontoEmCentavos Int @default(0)
  totalEmCentavos    Int

  // Cópia do endereço no momento da compra.
  entregaDestinatario String
  entregaCep          String
  entregaLogradouro   String
  entregaNumero       String
  entregaComplemento  String?
  entregaBairro       String
  entregaCidade       String
  entregaUf           String  @db.Char(2)

  // Frete (Melhor Envio)
  /// ID do serviço no Melhor Envio (1 = PAC, 2 = SEDEX...), para a etiqueta.
  freteServicoId        Int?
  freteServico          String?
  freteTransportadora   String?
  fretePrazoMinimoDias  Int?
  /// Prazo máximo em dias úteis.
  fretePrazoDias        Int?
  melhorEnvioEtiquetaId String?
  codigoRastreio        String?

  // Pagamento (Mercado Pago)
  mercadoPagoPreferenciaId String?
  /// Link da cobrança (init_point), reaproveitado enquanto o prazo valer.
  mercadoPagoLink          String?
  /// Última situação informada pelo Mercado Pago (pending, rejected...).
  mercadoPagoStatus        String?
  /// Preenchido só no pagamento aprovado.
  mercadoPagoPagamentoId   String?   @unique
  metodoPagamento          String?
  pagoEm                   DateTime?

  /// Algo para o administrador decidir (ex.: pago sem estoque, valor
  /// divergente). Nulo quando está tudo certo.
  alerta String?

  itens          ItemPedido[]
  movimentacoes  MovimentacaoEstoque[]
  /// Preenchido quando o pedido nasce de uma personalização aprovada.
  personalizacao Personalizacao?
  criadoEm       DateTime              @default(now())
  atualizadoEm   DateTime              @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("pedidos")
}

/// Guarda uma cópia de nome, cor, tamanho e preço: mudanças no catálogo
/// não alteram pedidos antigos.
model ItemPedido {
  id                      String   @id @default(uuid(7)) @db.Uuid
  quantidade              Int
  precoUnitarioEmCentavos Int
  nomeProduto             String
  nomeCor                 String
  nomeTamanho             String
  sku                     String
  pedidoId                String   @db.Uuid
  pedido                  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variacaoId              String   @db.Uuid
  variacao                Variacao @relation(fields: [variacaoId], references: [id])

  @@index([pedidoId])
  @@map("itens_pedido")
}

// ---------------------------------------------------------------- Personalização

enum StatusPersonalizacao {
  /// Enviado pelo cliente, esperando a prévia.
  RECEBIDA
  PREVIA_ENVIADA
  AJUSTE_SOLICITADO
  /// Cliente aprovou; falta escolher entrega e pagar.
  APROVADA
  /// Virou um pedido (pagamento pelo fluxo normal).
  CONVERTIDA
  CANCELADA

  @@map("status_personalizacao")
}

enum PosicaoEstampa {
  FRENTE_PEITO
  FRENTE_GRANDE
  COSTAS

  @@map("posicao_estampa")
}

enum TipoArquivoPersonalizacao {
  ARTE
  PREVIA

  @@map("tipo_arquivo_personalizacao")
}

enum AutorMensagem {
  CLIENTE
  LOJA

  @@map("autor_mensagem")
}

/// Pedido de camiseta com a arte do cliente. O preço é orçado caso a caso
/// pelo administrador junto com a prévia.
model Personalizacao {
  id     String               @id @default(uuid(7)) @db.Uuid
  /// Número mostrado ao cliente ("Personalização nº 1").
  numero Int                  @unique @default(autoincrement())
  status StatusPersonalizacao @default(RECEBIDA)

  clienteId String           @db.Uuid
  cliente   Cliente          @relation(fields: [clienteId], references: [id])
  /// Peça base (camiseta lisa), cor escolhida e posições da estampa.
  produtoId String           @db.Uuid
  produto   Produto          @relation(fields: [produtoId], references: [id])
  corId     String           @db.Uuid
  cor       Cor              @relation(fields: [corId], references: [id])
  posicoes  PosicaoEstampa[]

  /// Ideia, textos da estampa e observações do cliente.
  descricao     String?
  prazoDesejado DateTime? @db.Date

  /// Definido pelo administrador ao enviar a prévia.
  precoUnitarioEmCentavos Int?

  /// Pedido criado depois da aprovação.
  pedidoId String? @unique @db.Uuid
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  itens     PersonalizacaoItem[]
  arquivos  PersonalizacaoArquivo[]
  mensagens PersonalizacaoMensagem[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("personalizacoes")
}

model PersonalizacaoItem {
  id               String         @id @default(uuid(7)) @db.Uuid
  quantidade       Int
  personalizacaoId String         @db.Uuid
  personalizacao   Personalizacao @relation(fields: [personalizacaoId], references: [id], onDelete: Cascade)
  tamanhoId        String         @db.Uuid
  tamanho          Tamanho        @relation(fields: [tamanhoId], references: [id])

  @@unique([personalizacaoId, tamanhoId])
  @@map("personalizacao_itens")
}

/// Arquivo guardado no Supabase Storage (pasta privada "personalizacao").
model PersonalizacaoArquivo {
  id               String                    @id @default(uuid(7)) @db.Uuid
  tipo             TipoArquivoPersonalizacao
  /// Caminho no Storage: "<clienteId>/artes/..." ou "<clienteId>/previas/...".
  caminho          String                    @unique
  nomeOriginal     String
  tamanhoBytes     Int
  personalizacaoId String                    @db.Uuid
  personalizacao   Personalizacao            @relation(fields: [personalizacaoId], references: [id], onDelete: Cascade)
  criadoEm         DateTime                  @default(now())

  @@index([personalizacaoId])
  @@map("personalizacao_arquivos")
}

/// Pedidos de ajuste do cliente e recados da loja junto com a prévia.
model PersonalizacaoMensagem {
  id               String         @id @default(uuid(7)) @db.Uuid
  autor            AutorMensagem
  texto            String
  personalizacaoId String         @db.Uuid
  personalizacao   Personalizacao @relation(fields: [personalizacaoId], references: [id], onDelete: Cascade)
  criadoEm         DateTime       @default(now())

  @@index([personalizacaoId])
  @@map("personalizacao_mensagens")
}
